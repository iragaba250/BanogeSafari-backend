PORT=5000
MONGO_URI=mongodb://localhost:27017/banoge_safari
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins (your live frontend domain, or same-origin is fine)
CORS_ORIGIN=http://localhost:5173
# Public base URL used to build uploaded-image URLs (your live backend/domain)
PUBLIC_URL=http://localhost:5000
# Cloudinary storage for uploaded images (https://cloudinary.com - free tier)
# When these are set, uploaded images are stored in the cloud and never disappear on restart.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Resend API key for sending transactional emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Sender for outgoing emails, e.g. "Banoge Safari <noreply@yourdomain.com>"
EMAIL_FROM=Banoge Safari <onboarding@resend.dev>
